# Project enquiry database (use a persistent PostgreSQL service).
DATABASE_URL=postgresql://user:password@localhost:5432/techberry

# Resend transactional email (server-side only; never use VITE_ prefixes).
RESEND_API_KEY=
EMAIL_FROM=TechBerry <enquiries@techberry.com>
ADMIN_EMAIL=hello@techberry.com

# Admin dashboard credentials. Use a unique password with at least 16 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional legacy WhatsApp Cloud API credentials. Keep all secrets server-side.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_RECIPIENT_NUMBER=
WHATSAPP_TEMPLATE_NAME=website_enquiry_notification
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=

# Optional: set only when the app is behind a trusted reverse proxy.
# Set to a numeric hop count for your hosting topology.
TRUST_PROXY=
